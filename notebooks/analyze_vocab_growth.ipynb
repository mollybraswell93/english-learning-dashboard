import pandas as pd
import matplotlib.pyplot as plt

# Load your student vocabulary data
df = pd.read_csv('../data/student_vocab_records.csv')

# Plot vocabulary growth for each student
for student, data in df.groupby('student_name'):
    plt.plot(data['date'], data['total_words_mastered'], marker='o', label=student)

plt.title("Vocabulary Growth Over Time")
plt.xlabel("Date")
plt.ylabel("Total Words Mastered")
plt.legend()
plt.show()
